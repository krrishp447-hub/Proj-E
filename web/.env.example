# Public origin of the deployed site — canonical URLs, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Live creator data (optional: without these the site serves the illustrative demo dataset) ---
# Postgres connection string. On Vercel: Storage → add Neon → it injects DATABASE_URL automatically.
DATABASE_URL=
# Google Cloud → APIs & Services → enable "YouTube Data API v3" → Credentials → API key (restrict it to that API).
YOUTUBE_API_KEY=
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/ingest.
CRON_SECRET=

# --- Accounts (login, onboarding, creator channel connect) ---
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application). Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback  and  https://<your-domain>/api/auth/google/callback
# Also enable "YouTube Analytics API" in the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters. Signs session cookies and encrypts stored YouTube refresh tokens. Never change it casually:
# changing it signs everyone out and makes stored tokens unreadable (creators would need to reconnect).
AUTH_SECRET=
