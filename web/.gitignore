# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and confidential files
.env*
*.env
*.pem
*.key
*.cert
*.pfx
*.secret

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# excluded demo and launch assets
public/demo-video.html
demo-video.html
public/video/scout-launch*

